#!/bin/sh
set -eu

repository_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

if [ "$#" -ne 1 ]; then
    echo "Usage: $0 provision|disable|enable" >&2
    exit 64
fi

case "$1" in
    provision|disable|enable) ;;
    *)
        echo "Usage: $0 provision|disable|enable" >&2
        exit 64
        ;;
esac

cd "$repository_dir"
exec docker compose exec api java \
    -Dloader.main=pl.karolbystrek.kairos.api.operator.PlatformOperatorCommandApplication \
    -cp /app/app.jar \
    org.springframework.boot.loader.launch.PropertiesLauncher \
    "$1"
