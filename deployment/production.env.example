# Production defaults. Deployment writes /srv/kairos/production.env from this file
# plus GitHub production Environment values; blank settings must be set there.
COMPOSE_FILE=compose.yaml:compose.deployment.yaml

# Database configuration; passwords apply only on first database initialization.
POSTGRES_USER=kairos-user
POSTGRES_PASSWORD=
POSTGRES_DB=kairos-db
KAIROS_DB_OWNER_USER=kairos_owner
KAIROS_DB_OWNER_PASSWORD=
KAIROS_DB_RUNTIME_USER=kairos_runtime
KAIROS_DB_RUNTIME_PASSWORD=

# Redis configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Browser-visible origins
NEXT_PUBLIC_CUSTOMER_APP_URL=https://kairos.karolbystrek.pl
PANEL_APP_URL=https://kairos-panel.karolbystrek.pl
NEXT_PUBLIC_API_BASE_URL=https://kairos-api.karolbystrek.pl

# Gateway hostnames
KAIROS_CUSTOMER_APP_HOST=kairos.karolbystrek.pl
KAIROS_PANEL_APP_HOST=kairos-panel.karolbystrek.pl
KAIROS_API_HOST=kairos-api.karolbystrek.pl

# Gateway listen, TLS and forwarding settings live in the Compose files.
NGINX_ENVSUBST_FILTER=^KAIROS_

# Web Push identity
VAPID_SUBJECT=

NEXT_TELEMETRY_DISABLED=1

# Production webhook destinations must use public HTTPS.
WEBHOOK_DESTINATION_POLICY=PUBLIC_HTTPS

# Browser Push services use public HTTPS endpoints even during local development.
PUSH_DESTINATION_POLICY=PUBLIC_HTTPS

# Deployment supplies registry and immutable release version. Persistent host
# paths stay outside disposable release directories.
KAIROS_IMAGE_REGISTRY=
KAIROS_RELEASE_VERSION=
KAIROS_APPLICATION_SECRETS_DIRECTORY=/srv/kairos/secrets
# External Cloudflare Origin CA certificate directory containing tls.crt/tls.key.
KAIROS_TLS_DIRECTORY=/srv/kairos/tls

# Delay between order completion and the optional Google review invitation.
REVIEW_INVITATION_DELAY=30m

# Required Resend sending key; API refuses production startup without it.
EMAIL_DELIVERY_MODE=RESEND
RESEND_API_KEY=
