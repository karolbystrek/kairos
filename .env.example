# Docker development stack, selected by ./setup.sh --dev.
COMPOSE_FILE=compose.yaml:compose.local.yaml

# Database configuration
POSTGRES_HOST=postgres
POSTGRES_USER=kairos-user
POSTGRES_PASSWORD=kairos-password
POSTGRES_DB=kairos-db
KAIROS_DB_OWNER_USER=kairos_owner
KAIROS_DB_OWNER_PASSWORD=owner-local-password
KAIROS_DB_RUNTIME_USER=kairos_runtime
KAIROS_DB_RUNTIME_PASSWORD=runtime-local-password

# Redis configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Host key directory and its read-only mount inside the API container.
KAIROS_APPLICATION_SECRETS_DIRECTORY=./secrets
KAIROS_SECRETS_DIRECTORY=/run/secrets

# Browser-visible origins; browsers reach the published Docker ports.
NEXT_PUBLIC_CUSTOMER_APP_URL=http://localhost:3000
PANEL_APP_URL=http://localhost:3001
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Web Push identity
VAPID_SUBJECT=mailto:kairos@localhost

NEXT_TELEMETRY_DISABLED=1

# Local development deliberately permits HTTP and private webhook destinations.
# Production must set this to PUBLIC_HTTPS.
WEBHOOK_DESTINATION_POLICY=LOCAL_DEVELOPMENT

# Browser Push services use public HTTPS endpoints even during local development.
PUSH_DESTINATION_POLICY=PUBLIC_HTTPS

# Local development never sends real transactional email.
EMAIL_DELIVERY_MODE=LOG
# Skip registration email codes locally; the API defaults to requiring verification.
EMAIL_VERIFICATION_ENABLED=false
RESEND_API_KEY=
# Send review invitations soon after completion so the flow is easy to try.
REVIEW_INVITATION_DELAY=1m
