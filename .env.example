# Compose configuration. A hosted environment changes the second file to
# compose.deployment.yaml; ordinary docker compose commands stay unchanged.
COMPOSE_FILE=compose.yaml:compose.local.yaml

# Database configuration
POSTGRES_USER=kairos-user
POSTGRES_PASSWORD=kairos-password
POSTGRES_DB=kairos-db

# Redis configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Browser-visible origins
NEXT_PUBLIC_CUSTOMER_APP_URL=https://customer.kairos.localhost
PANEL_APP_URL=https://panel.kairos.localhost
NEXT_PUBLIC_API_BASE_URL=https://api.kairos.localhost

# Gateway hostnames
KAIROS_CUSTOMER_APP_HOST=customer.kairos.localhost
KAIROS_PANEL_APP_HOST=panel.kairos.localhost
KAIROS_API_HOST=api.kairos.localhost

# Gateway defaults; local TLS and hosted forwarding are set by their overlays.
KAIROS_NGINX_LISTEN="80"
KAIROS_NGINX_REAL_IP_CONFIGURATION=""
KAIROS_NGINX_TLS_CONFIGURATION=""
NGINX_ENVSUBST_FILTER=^KAIROS_

# Self-hosted ZITADEL; browser login stays on the Kairos panel.
ZITADEL_API_URL=http://zitadel:8080
ZITADEL_DB=zitadel
ZITADEL_DB_USER=zitadel
ZITADEL_DB_PASSWORD=zitadel-local-password
# Bootstrap creates a restricted API service account and writes its PAT to a
# private Compose volume. setup.sh generates secrets/zitadel-masterkey.
ZITADEL_TOKEN_LOCATION=file:/run/zitadel/kairos.pat

# Provider initialization and password policy (applied on first initialization).
ZITADEL_EXTERNALDOMAIN=zitadel
ZITADEL_EXTERNALPORT="8080"
ZITADEL_EXTERNALSECURE="false"
ZITADEL_TLS_ENABLED="false"
ZITADEL_DATABASE_POSTGRES_HOST=postgres
ZITADEL_DATABASE_POSTGRES_PORT="5432"
ZITADEL_DATABASE_POSTGRES_USER_SSL_MODE=disable
ZITADEL_DATABASE_POSTGRES_ADMIN_SSL_MODE=disable
ZITADEL_FIRSTINSTANCE_ORG_NAME=Kairos
# Local-only administrator password; change before deployment.
ZITADEL_FIRSTINSTANCE_ORG_HUMAN_PASSWORD=Kairos-local-admin-password
ZITADEL_FIRSTINSTANCE_ORG_MACHINE_MACHINE_USERNAME=kairos-bootstrap
ZITADEL_FIRSTINSTANCE_ORG_MACHINE_MACHINE_NAME=Kairos bootstrap
ZITADEL_FIRSTINSTANCE_ORG_MACHINE_PAT_EXPIRATIONDATE="2099-01-01T00:00:00Z"
ZITADEL_FIRSTINSTANCE_PATPATH=/bootstrap/admin.pat
ZITADEL_DEFAULTINSTANCE_DOMAINPOLICY_USERLOGINMUSTBEDOMAIN="false"
ZITADEL_DEFAULTINSTANCE_PASSWORDCOMPLEXITYPOLICY_MINLENGTH="12"
ZITADEL_DEFAULTINSTANCE_PASSWORDCOMPLEXITYPOLICY_HASLOWERCASE="false"
ZITADEL_DEFAULTINSTANCE_PASSWORDCOMPLEXITYPOLICY_HASUPPERCASE="false"
ZITADEL_DEFAULTINSTANCE_PASSWORDCOMPLEXITYPOLICY_HASNUMBER="false"
ZITADEL_DEFAULTINSTANCE_PASSWORDCOMPLEXITYPOLICY_HASSYMBOL="false"
ZITADEL_DEFAULTINSTANCE_PASSWORDAGEPOLICY_MAXAGEDAYS="0"
ZITADEL_DEFAULTINSTANCE_LOGINPOLICY_ALLOWEXTERNALIDP="false"
ZITADEL_DEFAULTINSTANCE_LOGINPOLICY_ALLOWREGISTER="false"
ZITADEL_DEFAULTINSTANCE_NOTIFICATIONPOLICY_PASSWORDCHANGE="false"
ZITADEL_LOGSTORE_ACCESS_STDOUT_ENABLED="false"

# Web Push identity
VAPID_SUBJECT=mailto:kairos@localhost

NEXT_TELEMETRY_DISABLED=1

# Local Compose deliberately permits HTTP and private webhook destinations.
# A production Compose deployment must set this to PUBLIC_HTTPS.
WEBHOOK_DESTINATION_POLICY=LOCAL_DEVELOPMENT

# Browser Push services use public HTTPS endpoints even during local development.
PUSH_DESTINATION_POLICY=PUBLIC_HTTPS

# Deployment overlay only. Keep these blank locally. The image registry must
# not end with a slash, the release version should identify one immutable
# application release, and every host path must be absolute.
KAIROS_IMAGE_REGISTRY=
KAIROS_RELEASE_VERSION=
KAIROS_APPLICATION_SECRETS_DIRECTORY=
# External Cloudflare Origin CA certificate directory containing tls.crt/tls.key.
KAIROS_TLS_DIRECTORY=
