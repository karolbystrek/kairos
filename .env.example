# Compose configuration. A hosted environment changes the second file to
# compose.deployment.yaml; ordinary docker compose commands stay unchanged.
COMPOSE_FILE=compose.yaml:compose.local.yaml

# Database configuration
POSTGRES_USER=kairos-user
POSTGRES_PASSWORD=kairos-password
POSTGRES_DB=kairos-db
KAIROS_DB_OWNER_USER=kairos_owner
KAIROS_DB_OWNER_PASSWORD=owner-local-password
KAIROS_DB_RUNTIME_USER=kairos_runtime
KAIROS_DB_RUNTIME_PASSWORD=runtime-local-password

# Redis configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Browser-visible origins
NEXT_PUBLIC_CUSTOMER_APP_URL=https://customer.kairos.localhost
PANEL_APP_URL=https://panel.kairos.localhost
NEXT_PUBLIC_API_BASE_URL=https://api.kairos.localhost

# Gateway hostnames
KAIROS_CUSTOMER_APP_HOST=customer.kairos.localhost
KAIROS_PANEL_APP_HOST=panel.kairos.localhost
KAIROS_API_HOST=api.kairos.localhost

# Gateway listen, TLS and forwarding settings live in the Compose files.
NGINX_ENVSUBST_FILTER=^KAIROS_

# Web Push identity
VAPID_SUBJECT=mailto:kairos@localhost

NEXT_TELEMETRY_DISABLED=1

# Local Compose deliberately permits HTTP and private webhook destinations.
# A production Compose deployment must set this to PUBLIC_HTTPS.
WEBHOOK_DESTINATION_POLICY=LOCAL_DEVELOPMENT

# Browser Push services use public HTTPS endpoints even during local development.
PUSH_DESTINATION_POLICY=PUBLIC_HTTPS

# Deployment overlay only. Keep these blank locally. The image registry must
# not end with a slash, the release version should identify one immutable
# application release, and every host path must be absolute.
KAIROS_IMAGE_REGISTRY=
KAIROS_RELEASE_VERSION=
KAIROS_APPLICATION_SECRETS_DIRECTORY=
# External Cloudflare Origin CA certificate directory containing tls.crt/tls.key.
KAIROS_TLS_DIRECTORY=

# Local development never sends real transactional email.
EMAIL_DELIVERY_MODE=LOG
# Skip registration email codes locally; the API defaults to requiring verification.
EMAIL_VERIFICATION_ENABLED=false
RESEND_API_KEY=
