server_tokens off;

client_max_body_size 1m;
client_body_timeout 30s;
client_header_timeout 15s;
client_header_buffer_size 1k;
large_client_header_buffers 4 8k;
keepalive_requests 1000;
send_timeout 30s;
reset_timedout_connection on;

limit_conn_zone $binary_remote_addr zone=kairos_per_client:10m;
limit_conn kairos_per_client 100;
limit_conn_status 429;

${KAIROS_NGINX_REAL_IP_CONFIGURATION}

proxy_http_version 1.1;
proxy_connect_timeout 5s;
proxy_send_timeout 30s;
proxy_read_timeout 60s;
proxy_set_header Connection "";
proxy_set_header Host $host;
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-For $remote_addr;
proxy_set_header X-Forwarded-Host $host;
proxy_set_header X-Forwarded-Proto https;
proxy_set_header X-Forwarded-Port 443;
proxy_set_header Forwarded "";
proxy_set_header X-Forwarded-Prefix "";
proxy_set_header X-Forwarded-Server "";
proxy_set_header CF-Connecting-IP "";

server {
    listen 127.0.0.1:8080;
    server_name localhost;

    access_log off;

    location = /health {
        default_type text/plain;
        return 200 "healthy\n";
    }

    location / {
        return 404;
    }
}

server {
    listen ${KAIROS_NGINX_LISTEN} default_server;
    server_name "";

    ${KAIROS_NGINX_TLS_CONFIGURATION}

    return 444;
}

server {
    listen ${KAIROS_NGINX_LISTEN};
    server_name ${KAIROS_CUSTOMER_APP_HOST};

    ${KAIROS_NGINX_TLS_CONFIGURATION}

    location = /api {
        return 404;
    }

    location ^~ /api/ {
        return 404;
    }

    location / {
        proxy_pass http://customer-app:3000;
    }
}

server {
    listen ${KAIROS_NGINX_LISTEN};
    server_name ${KAIROS_PANEL_APP_HOST};

    ${KAIROS_NGINX_TLS_CONFIGURATION}

    location = /api {
        return 404;
    }

    location ^~ /api/ {
        return 404;
    }

    location / {
        proxy_pass http://panel-app:3000;
    }
}

server {
    listen ${KAIROS_NGINX_LISTEN};
    server_name ${KAIROS_API_HOST};

    ${KAIROS_NGINX_TLS_CONFIGURATION}

    location = /api/actuator {
        return 404;
    }

    location ^~ /api/actuator/ {
        return 404;
    }

    location ~ ^/api/tracked-orders/v1/[^/]+/events$ {
        proxy_pass http://api:8080;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 31m;
        add_header X-Accel-Buffering "no" always;
    }

    location /api/ {
        proxy_pass http://api:8080;
    }

    location / {
        return 404;
    }
}
